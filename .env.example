# RecallGuardian push-alerts backend env vars.
# Set these in Vercel (Project Settings -> Environment Variables).
# The poller also needs POLL_SECRET + POLL_URL as GitHub Actions secrets.
# NEVER commit real values.

# --- Supabase (Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, bypasses RLS

# --- APNs (Apple Developer -> Keys) ---
APNS_KEY_ID=ABCDE12345                 # the 10-char Key ID of your .p8 key
APNS_TEAM_ID=VSGF6KPZCQ                 # your Apple Developer Team ID
APNS_BUNDLE_ID=ca.recallguardian.app   # the app's bundle id (= apns-topic)
# Paste the FULL contents of the .p8 file. Keep the BEGIN/END lines.
# In Vercel you can paste real newlines; locally use \n escapes on one line.
APNS_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 'production' for TestFlight/App Store builds, 'sandbox' for dev builds.
APNS_ENV=production

# --- Poller auth ---
# A long random string. Same value in Vercel env AND GitHub Actions secret.
POLL_SECRET=generate-a-long-random-string
# (GitHub secret only) the deployed endpoint, e.g. https://recallguardian.ca/api/poll
# POLL_URL=https://recallguardian.ca/api/poll
